APP_NAME=YourERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_CURRENCY=USD

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supported drivers are pgsql, mysql and mariadb only - see
# Webkul\Support\Database\Dialects, which throws for anything else. sqlite in
# particular does NOT work, despite being Laravel's own default.
# These values match the pgsql service in docker-compose.yml.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=dekaerp
DB_USERNAME=sail
DB_PASSWORD=password

# MySQL alternative, matching the mysql service in docker-compose.yml:
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306

# Managed Postgres (Supabase in production). Set DB_URL instead of the discrete
# fields above - when DB_URL is present it overrides host, port, database and
# credentials entirely.
#
# Use the POOLED connection for the application and the DIRECT one for
# migrations. Poolers run in transaction mode and do not hold session state
# between statements, which breaks some schema changes.
#   Supabase: pooled = Supavisor on port 6543, direct = port 5432
# DB_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Minutes until an issued Sanctum API token expires. 43200 = 30 days.
SANCTUM_TOKEN_EXPIRATION=43200

# Comma-separated list of reverse proxy / load balancer IPs (or CIDR ranges) to trust
# for X-Forwarded-* headers. Leave empty to trust none. Do not use "*" in production.
TRUSTED_PROXIES=

MEMCACHED_HOST=127.0.0.1

# In production set SESSION_DRIVER, CACHE_STORE and QUEUE_CONNECTION to redis.
# Left on the database driver, every request performs session and cache queries
# against Postgres, and queue:work polls the jobs table every three seconds -
# which on a managed provider is billed traffic that buys nothing.
#
# Note Redis then holds live sessions and queued jobs: a restart without
# persistence logs everyone out and discards pending jobs.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

NATIVEPHP_APP_ID=com.example.aureuserp.barcode
NATIVEPHP_APP_VERSION=DEBUG
NATIVEPHP_APP_VERSION_CODE=1
NATIVEPHP_START_URL=https://your-domain.tld/admin/barcode?nativephp=1
