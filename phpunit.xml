    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Dedicated test database: the test bootstrap runs migrate:fresh, so this
             MUST point at a throwaway DB and never the dev/production database.
             Every connection field is pinned to the local Docker pgsql service on
             purpose. DB_URL is blanked first because a URL, when set, overrides
             host/database/credentials wholesale - so a Neon DB_URL left in .env
             would otherwise route migrate:fresh straight at the remote database. -->
        <env name="DB_URL" value=""/>
        <!-- neon env pull writes DATABASE_URL into .env. Laravel reads DB_URL, so
             it is inert today - blanked anyway, because the test bootstrap runs
             migrate:fresh and this value points at the production database. -->
        <env name="DATABASE_URL" value=""/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="pgsql"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="aureuserp_testing"/>
        <env name="DB_USERNAME" value="sail"/>
        <env name="DB_PASSWORD" value="password"/>
        <env name="DB_SSLMODE" value="prefer"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Sentry stays off while the suite runs. This file does not inherit
             .env.example, so a developer's .env carries the real
             SENTRY_LARAVEL_DSN and every `php artisan test` run shipped the
             exceptions the application deliberately report()s - and its traced
             transactions - to the production project, tagged
             environment=testing. Sentry issue 155782383 ("RuntimeException:
             smtp down") is one of those: a SecurityFeature test throwing a
             simulated mail failure on purpose.
             force="true" is required, because PHPUnit otherwise leaves a DSN
             exported into the shell in place. An empty DSN makes the SDK's own
             hasDsnSet() false, so no client, transport or integration is built
             at all - a before_send filter would still boot and still trace. -->
        <env name="SENTRY_LARAVEL_DSN" value="" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
